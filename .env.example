# Plantilla de variables de entorno — Autoken Facturas v2
# Copia a `.env` (ignorado por git) y rellena con valores reales en el VPS.
# NUNCA pongas valores reales en este fichero ni en ningún archivo versionado.
# Mapa de secretos: ver PLAN_MAESTRO §9.1.

# === App ===
APP_ENV=development            # development | staging | production
# standalone solo para desarrollo/carga aislada; staging/production usan el overlay proxy.
DEPLOYMENT_PROFILE=standalone
LOG_LEVEL=info

# === PostgreSQL (generado en el VPS) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autoken
POSTGRES_USER=autoken_app      # usuario de app: NO owner, NO superuser (RLS)
POSTGRES_PASSWORD=

# === Redis (rate-limit login + rotación refresh + tokens de activación, S1.3) ===
REDIS_URL=redis://redis:6379/0

# Pool de Postgres para la carga concurrente de uploads. Ajustar al max_connections del servidor
# teniendo en cuenta el numero de procesos/replicas de la API.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# Comprobación de conexiones inactivas al reutilizar el pool. Mantenerla activa salvo una prueba
# controlada: evita reutilizar conexiones muertas tras una caída de Postgres o de red.
DB_POOL_PRE_PING=true

# R-051: flags de rollout. Se mantienen activas para conservar el comportamiento actual; apagar una
# permite rollback funcional. La allowlist es JSON con UUIDs de tenants piloto y nunca se expone al cliente.
SCANNER_V2_ENABLED=true
CONTINUOUS_CAPTURE_ENABLED=true
REVIEW_INBOX_ENABLED=true
DRAFT_AUTOSAVE_ENABLED=true
PROCESSING_STAGES_ENABLED=true
OCR_POLICY_V2_ENABLED=true
SUPPLIER_LEARNING_ENABLED=true
ROLLOUT_TENANT_ALLOWLIST=[]

# === Intake de ficheros: MinIO + antivirus (S2.1, ADR-0015) ===
# Object storage (bucket por tenant). En dev/CI local: localhost:9000 / minioadmin / minioadmin.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# Tamaño maximo del fichero de intake (bytes). Por defecto 15 MiB.
MAX_UPLOAD_BYTES=15728640
# Antivirus fail-closed. Sin fijar: `signature` (en proceso) fuera de produccion, `clamd` en produccion.
VIRUS_SCANNER_BACKEND=

# === Worker OCR (S2.3, ADR-0016): cola arq sobre el mismo Redis ===
# Nombre de la cola en la que la API encola `run_ocr` y de la que consume el worker (no secreto).
OCR_QUEUE_NAME=autoken:queue:ocr
# Credenciales Vertex/Gemini del worker (es el ÚNICO proceso que llama al motor real gemini-3-flash).
# Sin ellas, en staging/prod cada fichero caería a `ocr_failed`. Proyecto y region NO son secretos; el
# JSON de la service account SI (vive en `secrets/vertex-sa.json` del VPS, montado read-only, NO en git).
GOOGLE_CLOUD_PROJECT=
GEMINI_LOCATION=global
# Producción apunta a una versión estable elegida manualmente, nunca a `latest`.
GEMINI_FLASH_MODEL=gemini-3.5-flash
# Candidatos explícitos del benchmark, sin promoción automática a producción.
GEMINI_35_FLASH_MODEL=gemini-3.5-flash
GEMINI_36_FLASH_MODEL=gemini-3.6-flash
GEMINI_35_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# En el contenedor del worker apunta al SA montado en /run/secrets/vertex-sa.json (ver docker-compose).
GOOGLE_APPLICATION_CREDENTIALS=

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# === Seguridad ===
JWT_SECRET=                    # generado en el VPS (firma HS256 de los access token, S1.3)
# Autenticación S1.3 (identity) — no secretos; se dejan los defaults salvo ajuste operativo:
# JWT_ACCESS_TTL=900           # vida del access token en segundos (15 min)
# JWT_REFRESH_TTL=1209600      # vida del refresh en segundos (14 días)
# PASSWORD_MIN_LENGTH=12       # política de contraseña (mínimo de caracteres)
# LOGIN_MAX_ATTEMPTS=5         # fallos por (IP+email) antes del bloqueo temporal (429)
# LOGIN_WINDOW_SECONDS=900     # ventana del rate-limit de login (15 min)
# LOGIN_IP_MAX_ATTEMPTS=20     # tope más grueso por IP (credential spraying)
# ACTIVATION_TTL=259200        # vida del token de activación de un solo uso (72 h)
# Registro con aprobación S1.4 (identity) — anti-spam del alta pública:
# REGISTER_MAX_PER_IP=20       # altas por IP permitidas en la ventana antes del 429
# REGISTER_WINDOW_SECONDS=3600 # ventana del rate-limit de registro (1 h)
# EMAIL_VERIFICATION_TTL=86400 # vida del token de verificación del email del registrante (24 h)
# Recuperación de contraseña (sistema de acceso completo) — token de un solo uso + anti-spam:
# PASSWORD_RESET_TTL=3600           # vida del token de restablecimiento (1 h)
# PASSWORD_RESET_MAX_PER_EMAIL=5    # solicitudes por (IP+email) antes del 429
# PASSWORD_RESET_MAX_PER_IP=20      # tope más grueso por IP
# PASSWORD_RESET_WINDOW_SECONDS=900 # ventana del rate-limit (15 min)
# Claves Fernet por tenant: generadas y almacenadas cifradas en el VPS

# === OCR — Azure (GitHub Secrets + .env del VPS) ===
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# === OCR — Mistral (solo POC) ===
MISTRAL_API_KEY=

# === Verificación del CIF de contraparte S2.8 (counterparty, ADR-0011) ===
# Fuentes externas L3. En CI van dobladas; estos valores solo se usan con los clientes reales
# (staging). AEAT censal (VNifV2, SOAP mutual-TLS): endpoint + certificado PEM (cert+clave) en
# secrets/ (gitignored) + su contraseña (secretos, llegan por env var en el VPS).
AEAT_ENDPOINT=
AEAT_CERT_PATH=
AEAT_CERT_PASSWORD=
# AEAT_TIMEOUT=10
# VIES (checkVatApprox, público): determinante solo intra-UE. Se deja el WSDL oficial por defecto.
# VIES_ENDPOINT=https://ec.europa.eu/taxation_customs/vies/services/checkVatService.wsdl
# VIES_TIMEOUT=10
# BORME (OpenMercantil/LibreBOR, HTTP público): enriquece CIF->razón social de sociedades.
BORME_BASE_URL=
# BORME_TIMEOUT=10
# TTL de la caché global de resoluciones cif_lookups (segundos; 30 días por defecto).
# CIF_CACHE_TTL_SECONDS=2592000

# === SMTP (soporte@autoken.es) ===
# Sin SMTP_HOST, la app usa el grabador en memoria (RecordingNotifier): no rompe nada, pero no
# envía ningún email de verdad (útil en dev/staging sin credenciales todavía). Con SMTP_HOST
# puesto, la app usa SmtpNotifier de verdad: revisa también SMTP_USE_TLS (true=587 STARTTLS,
# false=465 SSL directo). Cómo comprobar si Hostinger ya tiene el buzón: panel de Correos de
# Hostinger (host típico smtp.hostinger.com); prueba de conectividad:
#   openssl s_client -connect smtp.hostinger.com:465 -crlf
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soporte@autoken.es
SMTP_USE_TLS=true

# === Observabilidad (S5.6) ===
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=            # cambiar en staging/producción; "admin" por defecto es solo dev
