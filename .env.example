# Plantilla de variables de entorno — Autoken Facturas v2
# Copia a `.env` (ignorado por git) y rellena con valores reales en el VPS.
# NUNCA pongas valores reales en este fichero ni en ningún archivo versionado.
# Mapa de secretos: ver PLAN_MAESTRO §9.1.

# === App ===
APP_ENV=development            # development | staging | production
LOG_LEVEL=info

# === PostgreSQL (generado en el VPS) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autoken
POSTGRES_USER=autoken_app      # usuario de app: NO owner, NO superuser (RLS)
POSTGRES_PASSWORD=

# === Redis (rate-limit login + rotación refresh + tokens de activación, S1.3) ===
REDIS_URL=redis://redis:6379/0

# === Intake de ficheros: MinIO + antivirus (S2.1, ADR-0015) ===
# Object storage (bucket por tenant). En dev/CI local: localhost:9000 / minioadmin / minioadmin.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
# Tamaño maximo del fichero de intake (bytes). Por defecto 15 MiB.
MAX_UPLOAD_BYTES=15728640
# Antivirus fail-closed. Sin fijar: `signature` (en proceso) fuera de produccion, `clamd` en produccion.
VIRUS_SCANNER_BACKEND=

# === Worker OCR (S2.3, ADR-0016): cola arq sobre el mismo Redis ===
# Nombre de la cola en la que la API encola `run_ocr` y de la que consume el worker (no secreto).
OCR_QUEUE_NAME=autoken:queue:ocr
# Credenciales Vertex/Gemini del worker (es el ÚNICO proceso que llama al motor real gemini-3-flash).
# Sin ellas, en staging/prod cada fichero caería a `ocr_failed`. Proyecto y region NO son secretos; el
# JSON de la service account SI (vive en `secrets/vertex-sa.json` del VPS, montado read-only, NO en git).
GOOGLE_CLOUD_PROJECT=
GEMINI_LOCATION=global
GEMINI_FLASH_MODEL=gemini-3-flash-preview
# En el contenedor del worker apunta al SA montado en /run/secrets/vertex-sa.json (ver docker-compose).
GOOGLE_APPLICATION_CREDENTIALS=

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# === Seguridad ===
JWT_SECRET=                    # generado en el VPS (firma HS256 de los access token, S1.3)
# Autenticación S1.3 (identity) — no secretos; se dejan los defaults salvo ajuste operativo:
# JWT_ACCESS_TTL=900           # vida del access token en segundos (15 min)
# JWT_REFRESH_TTL=1209600      # vida del refresh en segundos (14 días)
# PASSWORD_MIN_LENGTH=12       # política de contraseña (mínimo de caracteres)
# LOGIN_MAX_ATTEMPTS=5         # fallos por (IP+email) antes del bloqueo temporal (429)
# LOGIN_WINDOW_SECONDS=900     # ventana del rate-limit de login (15 min)
# LOGIN_IP_MAX_ATTEMPTS=20     # tope más grueso por IP (credential spraying)
# ACTIVATION_TTL=259200        # vida del token de activación de un solo uso (72 h)
# Registro con aprobación S1.4 (identity) — anti-spam del alta pública:
# REGISTER_MAX_PER_IP=20       # altas por IP permitidas en la ventana antes del 429
# REGISTER_WINDOW_SECONDS=3600 # ventana del rate-limit de registro (1 h)
# Claves Fernet por tenant: generadas y almacenadas cifradas en el VPS

# === OCR — Azure (GitHub Secrets + .env del VPS) ===
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# === OCR — Mistral (solo POC) ===
MISTRAL_API_KEY=

# === SMTP (soporte@autoken.es) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soporte@autoken.es

# === Observabilidad ===
SENTRY_DSN=
